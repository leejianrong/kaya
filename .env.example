# Copy to kaya-notes/.env (repo root) for Fly/Neon deploy tooling — see docs/deploy/fly.md.
# `.env` is gitignored and secret-scanned. This is NOT read by the app — that's backend/.env
# (see backend/.env.example). Nothing here needs to be a Fly secret itself; it's only for the
# shell commands (flyctl, neonctl, curl) that provision and deploy kaya's own Fly app.

# https://fly.io/user/personal_access_tokens — "Create token"
FLY_API_TOKEN=

# https://console.neon.tech — Account Settings -> API Keys -> Create new API key
NEON_API_KEY=

# The pooled connection string Neon's console gives you for the project/database kaya uses,
# scheme unchanged (postgresql://, not postgresql+psycopg://) — that rewrite happens when this
# gets set as the Fly app's DATABASE_URL secret, not here. A relay value: read once to set the
# secret, doesn't need to stay here afterward.
NEON_DATABASE_URL=
