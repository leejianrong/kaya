#!/usr/bin/env bash
# Fast pre-push gate. Mirrors the CHEAP CI jobs and nothing else — a slow check here
# gets bypassed, and a bypassed gate protects nothing (dev-playbook §6).
#
# Escape hatch: git push --no-verify
#
# Each block is guarded on the tooling actually existing, so this hook stays useful
# as the repo grows instead of needing a rewrite per slice.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

status=0
run() {
  printf '\n▸ %s\n' "$1"; shift
  "$@" || status=1
}

run "internal doc links"       scripts/check-docs-links.sh
# KAN-580: gitleaks over the tracked tree, ~0.9s once the pinned binary is cached; the
# first run on a machine also fetches it (~10 MB, digest-checked, cached under ~/.cache and
# shared across worktrees). History is NOT scanned here — `make secret-scan-history` does
# that on demand, and secret-scan.sh explains why putting it in the gate would only teach
# people to reach for --no-verify.
run "secret scan"              scripts/secret-scan.sh
# Offline and instant — it reads the shape of an image reference rather than asking a
# registry. KAN-538: a base image on a floating tag makes the provenance labels a lie.
run "image pins"               scripts/check-image-pins.sh
# ADR 0007 §3 wants this "enforced by a pre-push hook and a CI job", and it sits with the other
# offline guards rather than inside the kaya-cli block for the same reason its CI job is not
# gated on `detect`: it covers all three shipped packages, and a push touching only kaya-client
# or only mcp has to reach it. A few `git` calls and one `tomllib` parse per package — no
# network, no virtualenv, nothing that would teach anyone to reach for --no-verify. KAN-544.
run "version-bump guard"       scripts/check-version-bump.sh

if [ -d backend ] && command -v uv >/dev/null 2>&1; then
  run "backend lint"           bash -c 'cd backend && uv run ruff check .'
  run "backend unit tests"     bash -c 'cd backend && uv run pytest tests/unit -q'
fi

if [ -d kaya-client ] && command -v uv >/dev/null 2>&1; then
  run "client lint"            bash -c 'cd kaya-client && uv run ruff check .'
  run "client unit tests"      bash -c 'cd kaya-client && uv run pytest -q'
fi

if [ -d kaya-cli ] && command -v uv >/dev/null 2>&1; then
  run "cli lint"               bash -c 'cd kaya-cli && uv run ruff check .'
  run "cli unit tests"         bash -c 'cd kaya-cli && uv run pytest -q'
fi

if [ -d mcp ] && command -v uv >/dev/null 2>&1; then
  run "mcp lint"               bash -c 'cd mcp && uv run ruff check .'
  # ADR 0006: the frozen tool set and the tool count live here. A widened MCP surface fails
  # locally rather than in review.
  run "mcp unit tests"         bash -c 'cd mcp && uv run pytest -q'
fi

if [ -d frontend ] && [ -f frontend/package.json ]; then
  run "frontend lint"          bash -c 'cd frontend && npm run lint --if-present'
  run "frontend unit tests"    bash -c 'cd frontend && npm test --if-present'
fi

echo ""
if [ "$status" -ne 0 ]; then
  echo "✗ pre-push checks failed. Fix them, or push with --no-verify if you have a"
  echo "  specific reason and are prepared to say what it was."
  exit 1
fi
echo "✓ pre-push checks passed"
