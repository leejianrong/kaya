# Copy to backend/.env for local overrides. `.env` is gitignored and secret-scanned.
# Nothing in here is a secret today: kaya holds no long-lived credential of its own, it forwards
# the caller's bearer upstream (ADR 0002).

# Matches docker-compose.yml. The +psycopg driver is psycopg v3 (ADR 0001) — not psycopg2.
DATABASE_URL=postgresql+psycopg://kaya:kaya@localhost:5432/kaya

# The pandan deployment that resolves principals. Configuration, not a secret.
KAYA_PANDAN_URL=https://simple-kanban-jian.fly.dev

# Where the built SPA lives, if this process is to serve it from its own origin (KAN-538). Unset
# means the API serves alone — which is what `make dev` wants, since Vite serves the SPA on :5173
# and proxies `/api` back. No directory is guessed at: serving a build nobody can date is worse
# than serving none. The container image sets this itself.
# KAYA_SPA_DIST=../frontend/dist
