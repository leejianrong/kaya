# Copy to backend/.env for local overrides. `.env` is gitignored and secret-scanned.
# Nothing in here is a secret today: kaya holds no long-lived credential of its own, it forwards
# the caller's bearer upstream (ADR 0002).

# Matches docker-compose.yml. The +psycopg driver is psycopg v3 (ADR 0001) — not psycopg2.
DATABASE_URL=postgresql+psycopg://kaya:kaya@localhost:5432/kaya

# The pandan deployment that resolves principals. Configuration, not a secret. Unused until
# KAN-534 lands the resolver.
KAYA_PANDAN_URL=https://simple-kanban-jian.fly.dev
